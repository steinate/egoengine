+replay=json.loads((out/'overview.json').read_text());validation=json.loads((out/'trajectory-validation.json').read_text())
+assert replay['frames']==validation['frames']
+assert replay['max_object_position_error_m']<1e-5
+assert replay['max_object_rotation_error_deg']<.01
+(out/'pipeline-result.json').write_text(json.dumps({'passed':True,'source_plan':str(plan),'output_directory':str(out),
+    'trajectory':validation,'replay':replay},indent=2))
+print('PIPELINE_OK',str(out),flush=True)
