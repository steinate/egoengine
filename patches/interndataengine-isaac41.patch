+    before=set((root/'outputs41/plan').rglob('*.pkl'))
+    run('configure','human_pair.make_task')
+    run('plan','human_pair.engine_job','--config','human_pair/configs/plan.yaml','--seed',a.seed,'--diagnostics')
+    new=set((root/'outputs41/plan').rglob('*.pkl'))-before
+    if len(new)!=1:raise RuntimeError(f'Expected one newly saved successful plan, got {len(new)}')
+    plan=new.pop()
+for suffix in ['.pkl','.meta.json','.scene.usdc']:
+    if not plan.with_suffix(suffix).is_file():raise FileNotFoundError(plan.with_suffix(suffix))
