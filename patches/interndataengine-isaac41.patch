+"""Run one task, fail closed on missing plans, export/validate/render its replay."""
+import argparse,json,subprocess,time
+from pathlib import Path
+p=argparse.ArgumentParser();p.add_argument('--existing-plan');p.add_argument('--output-dir');p.add_argument('--seed',type=int,default=42);a=p.parse_args()
+root=Path(__file__).resolve().parents[3];launcher=root/'run_env41.sh'
+out=Path(a.output_dir) if a.output_dir else root/'outputs41'/('verified-'+time.strftime('%Y%m%d-%H%M%S'))
+out.mkdir(parents=True,exist_ok=False)
+def run(name,module,*args):
